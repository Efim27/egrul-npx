{
  "name": "egrul-inn-mcp",
  "version": "1.0.3",
  "description": "STDIO MCP server for retrieving EGRUL and EGRIP data by INN, OGRN or OGRNIP",
  "type": "module",
  "bin": {
    "egrul-inn-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run build",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "egrul",
    "egrip",
    "inn",
    "ogrn",
    "ogrnip",
    "stdio",
    "npx"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2"
  }
}
